// CRUD --- PROFILE


### Create Profile
POST {{hostName}}:{{hostPort}}/profile
Authorization: {{jwtToken}}
Content-Type: application/json

{
    "bio": "hellohellohello",
    "avatar": "chua co nha"
}

### get Profile
GET {{hostName}}:{{hostPort}}/profile
Authorization: {{jwtToken}}

### Update profile
PATCH {{hostName}}:{{hostPort}}/profile
Authorization: {{jwtToken}}
Content-Type: application/json

{
    "bio": "papapa",
    "avatar": "chua co nha"
}

### Delete profile
DELETE {{hostName}}:{{hostPort}}/profile
Authorization: {{jwtToken}}














#######################################################################
#######################################################################

// CRUD --- POST


### Create post
POST {{hostName}}:{{hostPort}}/post 
Authorization: {{jwtToken}}
Content-Type: application/json

{
    "title": "yootek intern",
    "content": "nestjs, prisma, postgresql, jwt, passport, guard, module, import, export, controller, provider"
}

### Get all post (belong to user)
GET {{hostName}}:{{hostPort}}/post
Authorization: {{jwtToken}}

### Get post (belong to user)
GET {{hostName}}:{{hostPort}}/post/1
Authorization: {{jwtToken}}

### Update post (belong to user)
PATCH {{hostName}}:{{hostPort}}/post/1
Authorization: {{jwtToken}}
Content-Type: application/json

{
    "title": "yootek intern update",
    "content": "updated content: nestjs with something else"
}

### Delete post (belong to user)
DELETE {{hostName}}:{{hostPort}}/post/2
Authorization: {{jwtToken}}









